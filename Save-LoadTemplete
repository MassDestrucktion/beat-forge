/**
* Tone.js Project Serializer
* -----------------------------------------------------------------------
* Captures the current state of a track/project into a plain JSON object
* you can store in your database (JSONB column in Postgres, a blob in
* Mongo, etc.), and rebuilds the Tone.js graph from that JSON later.
*
* KEY IDEA: most Tone.js nodes (instruments, effects, filters) expose
* .get() -> returns current param values as a plain object
* .set(obj) -> restores those values
* You don't have to enumerate every ADSR/filter param by hand.
*/
 
// ---------------------------------------------------------------------
// 1. CAPTURE — call this whenever you want to save (autosave, manual save)
// ---------------------------------------------------------------------
 
function serializeProject(project) {
 // `project` is your own app-level object holding references to the
 // live Tone.js nodes for each track, e.g.:
 // project = { tracks: [{ id, instrument, channel, effects, pattern, sampleUrls }] }
 
 return {
   version: 1,
   savedAt: new Date().toISOString(),
   transport: {
     bpm: Tone.Transport.bpm.value,
     timeSignature: Tone.Transport.timeSignature,
     swing: Tone.Transport.swing,
     swingSubdivision: Tone.Transport.swingSubdivision,
     loopStart: Tone.Transport.loopStart,
     loopEnd: Tone.Transport.loopEnd,
   },
   tracks: project.tracks.map((track) => ({
     id: track.id,
     name: track.name,
     instrumentType: track.instrumentType, // "Synth" | "PolySynth" | "MembraneSynth" | "Sampler" ...
     instrumentParams: track.instrument.get(), // oscillator, envelope, filter, etc.
     // Samplers can't be reconstructed from .get() — store the source URLs instead
     sampleUrls: track.instrumentType === "Sampler" ? track.sampleUrls : undefined,
     channel: {
       volume: track.channel.volume.value,
       pan: track.channel.pan.value,
       mute: track.channel.mute,
       solo: track.channel.solo,
     },
     effects: track.effects.map((fx) => ({
       type: fx.type, // "Reverb" | "FeedbackDelay" | "Distortion" ...
       params: fx.node.get(),
       wet: fx.node.wet.value,
     })),
     // Your own note-event array. Tone.Sequence/Tone.Part don't serialize
     // themselves, so keep the data you used to build them, not the object.
     pattern: track.pattern, // e.g. [{ time: "0:0:0", note: "C4", duration: "8n", velocity: 0.8 }, ...]
   })),
 };
}
 
// Example: save to your backend
async function saveProject(projectId, project) {
 const json = serializeProject(project);
 await fetch(`/api/projects/${projectId}`, {
   method: "PUT",
   headers: { "Content-Type": "application/json" },
   body: JSON.stringify(json),
 });
}
 
// ---------------------------------------------------------------------
// 2. RESTORE — call this on load to rebuild the live Tone.js graph
// ---------------------------------------------------------------------
 
const INSTRUMENT_CLASSES = {
 Synth: Tone.Synth,
 PolySynth: Tone.PolySynth,
 MembraneSynth: Tone.MembraneSynth,
 FMSynth: Tone.FMSynth,
 // Sampler handled separately below since it needs urls at construction time
};
 
const EFFECT_CLASSES = {
 Reverb: Tone.Reverb,
 FeedbackDelay: Tone.FeedbackDelay,
 Distortion: Tone.Distortion,
 Chorus: Tone.Chorus,
 // add whatever effects your app supports
};
 
function buildInstrument(trackData) {
 if (trackData.instrumentType === "Sampler") {
   // Sampler needs URLs up front; params get applied after buffers load
   const sampler = new Tone.Sampler({ urls: trackData.sampleUrls });
   sampler.set(trackData.instrumentParams);
   return sampler;
 }
 const Ctor = INSTRUMENT_CLASSES[trackData.instrumentType];
 const instrument = new Ctor();
 instrument.set(trackData.instrumentParams);
 return instrument;
}
 
function buildEffectsChain(effectsData) {
 return effectsData.map((fxData) => {
   const Ctor = EFFECT_CLASSES[fxData.type];
   const node = new Ctor();
   node.set(fxData.params);
   node.wet.value = fxData.wet;
   return { type: fxData.type, node };
 });
}
 
function deserializeProject(json) {
 Tone.Transport.bpm.value = json.transport.bpm;
 Tone.Transport.timeSignature = json.transport.timeSignature;
 Tone.Transport.swing = json.transport.swing;
 Tone.Transport.swingSubdivision = json.transport.swingSubdivision;
 Tone.Transport.loopStart = json.transport.loopStart;
 Tone.Transport.loopEnd = json.transport.loopEnd;
 
 const tracks = json.tracks.map((trackData) => {
   const instrument = buildInstrument(trackData);
   const effects = buildEffectsChain(trackData.effects);
 
   const channel = new Tone.Channel({
     volume: trackData.channel.volume,
     pan: trackData.channel.pan,
     mute: trackData.channel.mute,
     solo: trackData.channel.solo,
   }).toDestination();
 
   // Wire instrument -> effects chain -> channel
   const chainNodes = [instrument, ...effects.map((e) => e.node), channel];
   for (let i = 0; i < chainNodes.length - 1; i++) {
     chainNodes[i].connect(chainNodes[i + 1]);
   }
 
   // Rebuild the sequence from your stored note-event array
   const sequence = new Tone.Part((time, event) => {
     instrument.triggerAttackRelease(event.note, event.duration, time, event.velocity);
   }, trackData.pattern.map((e) => [e.time, e])).start(0);
 
   return {
     id: trackData.id,
     name: trackData.name,
     instrumentType: trackData.instrumentType,
     instrument,
     effects,
     channel,
     pattern: trackData.pattern,
     sampleUrls: trackData.sampleUrls,
     sequence,
   };
 });
 
 return { tracks };
}
 
// Example: load from your backend
async function loadProject(projectId) {
 const res = await fetch(`/api/projects/${projectId}`);
 const json = await res.json();
 return deserializeProject(json);
}
 
module.exports = { serializeProject, deserializeProject, saveProject, loadProject };


