# ============================================================
# BeatForge — Environment Variables Template
# ============================================================
# Copy this file to `.env` (project root) for local dev, or set
# these as App Service / container environment variables in Azure.
#
# The backend loads .env from the project root (../.env relative
# to backend/), so in Docker the file must live at /app/.env.
# ============================================================

# --- Database ---
# Azure Database for PostgreSQL connection string.
# Example: postgres://user:password@myserver.postgres.database.azure.com:5432/beat_forge
DATABASE_URL=

# (Alternative) legacy local-dev connection string.
# DATABASE_CONNECTION=

# Force SSL on/off. Leave unset to auto-detect (SSL on for remote hosts).
# DATABASE_SSL=true

# --- Auth ---
# Secret used to sign JWTs. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# --- Server ---
# Port the Express server listens on (Azure App Service sets this automatically).
PORT=3000

# --- Azure Storage (optional, for future audio asset uploads) ---
# AZURE_STORAGE_CONNECTION_STRING=
# AZURE_STORAGE_CONTAINER_NAME=beatforge-assets
</arg_value>
